# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LinkedIn session ---------------------------------------------------
# LI_AT is the primary auth path in practice. LinkedIn's login flow issues a
# JavaScript challenge with no headless workaround (AGENTS.md §3), so supplying
# a session cookie directly is the known-correct answer, not a shortcut.
LI_AT=
JSESSIONID=

# Credentials for the login flow. Attempted only when LI_AT is absent, and
# expected to fail against the challenge.
LI_USER=
LI_PASS=

# --- Egress -------------------------------------------------------------
# Residential proxy, India exit, sticky session. Datacenter ASNs are blocked.
# Applied to LinkedIn traffic only; the API itself serves direct.
PROXY_URL=

# curl_cffi TLS impersonation profile. Must stay consistent with the
# user-agent the client sends (AGENTS.md §2.1, §2.3).
IMPERSONATE=chrome142

# --- Service ------------------------------------------------------------
# Published in the README on purpose: a reviewer who hits 401 with no key may
# simply abandon the demo.
API_KEY=demo-key
CACHE_PATH=cache.db
# 30 days. The 24-hour default expires seeded entries almost immediately; each
# request then attempts a doomed live fetch, spends daily budget, and serves
# stale. For a demo that may be reviewed days after deployment, set this high.
CACHE_TTL_SECONDS=2592000
RATE_LIMIT_PER_MIN=3

# Hard daily ceiling on live fetches using the shared session.
#
# This is the setting that protects the LinkedIn account. The demo API key is
# public, so without a daily cap anyone can generate scraping-shaped traffic
# attributed to one real person. Each profile costs ~6 upstream requests, so 40
# profiles is ~120 requests/day. Callers who supply their own session via
# X-LI-AT are exempt.
DAILY_LIVE_FETCH_BUDGET=20
